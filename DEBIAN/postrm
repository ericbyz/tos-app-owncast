#!/bin/bash
set -e
APPID="owncast"
if [ "$1" = "purge" ]; then
    systemctl stop "owncast.service" 2>/dev/null || true
    id -u "${APPID}" >/dev/null 2>&1 && userdel "${APPID}" 2>/dev/null || true
    rm -rf /var/lib/owncast /usr/local/owncast 2>/dev/null || true
    rm -f /etc/systemd/system/owncast.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi
exit 0
